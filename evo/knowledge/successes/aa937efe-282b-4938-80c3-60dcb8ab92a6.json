    "source_code": "struct Container {\n    value: Box<i32>,\n}\n\nfn main() {\n    let boxed_value = Box::new(42);\n    let container = Container { value: boxed_value };\n    \n    // Assert that the struct owns the Box containing 42\n    assert_eq!(*container.value, 42);\n    \n    // Drop the container to prove ownership transfer worked (no double free)\n    drop(container);\n    \n    println!(\"Ownership verified: 42\");\n}",
